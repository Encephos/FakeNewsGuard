# FakeNewsGuard – Konfigurationsvorlage
# Kopiere diese Datei: cp .env.example .env
# Trage deine Keys ein (mindestens ein LLM + SearXNG oder LangSearch)

# ── LLM (mindestens einer) ──────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...

# ── Web Search ──────────────────────────────────────────────────
# SearXNG (self-hosted, primäre Suchquelle – läuft im Docker-Compose mit)
SEARXNG_URL=http://localhost:8888
# SEARXNG_ENGINES=google,bing,duckduckgo   # leer = alle Engines
# CURRENT_STATE_TIME_RANGE=month           # SearXNG-Zeitraum für Amtsinhaber-Claims (day|week|month|year)

# LangSearch (semantische Websuche, parallel zu SearXNG genutzt)
LANGSEARCH_API_KEY=sk-...

# Tavily (optional, standardmäßig deaktiviert – SearXNG reicht als primäre Quelle)
# TAVILY_ENABLED=false      # Explizit auf true setzen um Tavily zuzuschalten
# TAVILY_API_KEY=tvly-...
# LANGSEARCH_BASE_URL=https://api.langsearch.com/v1  # Default-URL
# LANGSEARCH_ENABLED=true                             # Default: true wenn Key vorhanden

# ── Faktencheck-Quellen ─────────────────────────────────────────
# Google Fact Check Tools API (kostenlos über Google Cloud Console)
# API aktivieren: https://console.cloud.google.com → "Fact Check Tools API"
GOOGLE_FACT_CHECK_API_KEY=AIza...
# GOOGLE_FACT_CHECK_ENABLED=true   # Default: true wenn Key vorhanden

# ── Claim Processing ────────────────────────────────────────────
# CLAIM_TOP_N=5          # Max. Claims verarbeiten (0 = alle)
# USE_CANONICAL_CACHE=false  # Cache-Keys auf kanonischen Text statt Rohtext
# MIN_CHECKWORTHINESS=0.0    # Minimaler Checkworthiness-Score (0 = alle)

# ── Chain-of-Verification (CoVe) ───────────────────────────────
# COVE_ENABLED=true                          # CoVe aktivieren
# MAX_VERIFICATION_QUESTIONS=3               # Max. Verifikationsfragen pro Claim
# MAX_ADDITIONAL_VERIFICATION_SEARCHES=2     # Max. zusätzliche Suchen in CoVe

# ── Scraping ────────────────────────────────────────────────────
# SCRAPE_TOP_N=8         # Max. zu scrapende Quellen pro Claim
# SCRAPE_TIMEOUT=10.0    # HTTP-Timeout pro Scrape-Request (Sekunden)

# ── Scout-Tier (Modellauswahl) ──────────────────────────────────
# SCOUT_TIER=max         # lite | pro | max
# TIER_MODEL_SMALL=google/gemma-3-4b-it      # Kleines Modell (Lite-Tier)
# TIER_MODEL_MEDIUM=google/gemma-3-27b-it    # Mittleres Modell (Pro/Max-Tier)
# TIER_MODEL_FREE=openrouter/free            # Kostenloses Router-Modell (Lite)

# ── Datenbank-Backends (Produktion) ─────────────────────────────
# Backends auswählen:
#   DB_BACKEND=postgres    → UserDB, Archive, Graph → PostgreSQL
#   CACHE_BACKEND=valkey   → ClaimCache → Valkey (bereits im Stack)
# Ohne diese Variablen: SQLite (Dev-Fallback, vorhandene Dateien)

DB_BACKEND=postgres
CACHE_BACKEND=valkey

# PostgreSQL (wird von docker-compose als 'postgres'-Service bereitgestellt)
POSTGRES_PASSWORD=changeme        # ZWINGEND ändern!
# POSTGRES_HOST=postgres          # Default: postgres (Docker-Service-Name)
# POSTGRES_PORT=5432
# POSTGRES_DB=fakeguard
# POSTGRES_USER=fakeguard
# DATABASE_URL=postgresql://fakeguard:changeme@postgres:5432/fakeguard  # Alternative

# Valkey/Redis (bereits im Stack als 'valkey'-Service)
# VALKEY_URL=redis://valkey:6379/0  # Default (wird von docker-compose gesetzt)

# ── SQLite-Fallback-Pfade (Dev / Migration) ──────────────────────
# Nur relevant wenn DB_BACKEND=sqlite (lokale Entwicklung)
# CACHE_DB_PATH=/app/data/fakeguard_cache.db
# USERS_DB_PATH=/app/data/fakeguard_users.db
# ARCHIVE_DB_PATH=/app/data/fakeguard_archive.db
# GRAPH_DB_PATH=/app/data/fakeguard_graph.db
# CACHE_TTL_HOURS=24

# ── Rate Limiting ───────────────────────────────────────────────
# RATE_LIMIT_RPM=10      # Max. Analyse-Anfragen pro IP pro Minute
# RATE_LIMIT_BURST=3     # Max. Burst-Anfragen
# RATE_LIMIT_AUTH_RPM=5  # Auth-Endpunkt: Anfragen pro Minute
# RATE_LIMIT_AUTH_BURST=2

# ── Auth ────────────────────────────────────────────────────────
# JWT_SECRET=...         # Zufällig generiert wenn nicht gesetzt (Dev-Modus)
# AUTH_REFRESH_TOKEN_MAX_AGE=604800   # 7 Tage (Sekunden)
# AUTH_REMEMBER_ME_MAX_AGE=2592000    # 30 Tage (Sekunden)
# AUTH_MIN_PASSWORD_LENGTH=8
# AUTH_LINK_CODE_EXPIRATION=600       # Link-Code Ablauf (Sekunden)
# AUTH_MAX_DISPLAY_NAME=50

# ── API-Versionierung ───────────────────────────────────────────
# Kanonische Endpunkte: /api/v1/*
# Legacy-Redirects (308): /api/* → /api/v1/* (Abwärtskompatibilität)
# /api/health und /metrics bleiben unversioniert
# NEXT_PUBLIC_BACKEND_URL=/api/v1

# ── CORS ────────────────────────────────────────────────────────
# CORS_ORIGINS=https://fakeguard.example.com,https://app.example.com
# Standardwert "*" erlaubt alle Origins – in Produktion setzen!

# ── Telegram Bot (optional) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=...
# BACKEND_URL=http://backend:8000
# TELEGRAM_POLL_INTERVAL=2.0
# TELEGRAM_MAX_POLL_ATTEMPTS=960
# TELEGRAM_MSG_CHUNK_SIZE=4000
# TELEGRAM_HTTP_TIMEOUT=30.0
# TELEGRAM_POLL_TIMEOUT=15.0

# ── HTTP Timeouts ───────────────────────────────────────────────
# TIMEOUT_LLM=120.0           # LLM-API Timeout (Sekunden)
# TIMEOUT_LLM_CONNECT=10.0    # LLM-API Connect-Timeout
# TIMEOUT_SCRAPE=20.0         # Scraping-Timeout
# TIMEOUT_SEARCH=30.0         # Such-API Timeout
# TIMEOUT_SOURCE_CLIENT=15.0  # Institutionelle Quellen Timeout
# TIMEOUT_AGENT=180.0         # Agent-Gesamt-Timeout
# TIMEOUT_DOMAIN_TRUST=10.0   # Domain-Trust-API Timeout

# ── Job-Management ──────────────────────────────────────────────
# JOB_TTL_SECONDS=3600        # Job-Cleanup nach Abschluss (1h)
# JOB_TIMEOUT_SECONDS=1800    # Max. Job-Laufzeit (30min)
# JOB_INACTIVITY_TIMEOUT=300  # Inaktivitäts-Timeout (5min)
# JOB_CLAIM_BATCH_SIZE=4      # Claims pro Batch
# JOB_INACTIVITY_SCALING=30   # Sekunden pro Claim

# ── Verdict Calibration ────────────────────────────────────────
# VCAL_CEILING_NO_PRIMARY_SOURCE=0.82
# VCAL_CEILING_WEAK_EVIDENCE=0.70
# VCAL_CEILING_INSUFFICIENT_CONSENSUS=0.65
# (... weitere VCAL_* Variablen – siehe config/processing.py VerdictCalibrationConfig)

# ── Logging ─────────────────────────────────────────────────────
# VERBOSE=true

# ── Observability (OpenTelemetry + Prometheus) ──────────────────
# OTEL_ENABLED=true                        # OpenTelemetry Tracing aktivieren (Default: false)
# OTLP_ENDPOINT=http://localhost:4317      # OTLP gRPC Collector Endpoint
# OTEL_SERVICE_NAME=fakeguard-api          # Service-Name in Traces
# APP_VERSION=1.0.0                        # Version in Trace-Resource-Attributes
# DEPLOYMENT_ENV=production                # deployment.environment Attribut
# PROMETHEUS_ENABLED=true                  # /metrics Endpoint aktivieren (Default: true)

# ── Setup-Secret (API-Endpunkt für Erstkonfiguration) ───────────
# SETUP_SECRET=...
