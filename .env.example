# FakeNewsGuard – API Keys
# Kopiere diese Datei: cp .env.example .env
# Trage deine Keys ein (mindestens ein LLM + eine Suchmaschine)

# ── LLM (mindestens einer) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Web Search (mindestens einer) ──────────────────────────────
TAVILY_API_KEY=tvly-...      # Empfohlen: Free Tier verfügbar
# SERPER_API_KEY=...
# BRAVE_API_KEY=...
